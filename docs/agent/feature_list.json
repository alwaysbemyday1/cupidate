{
  "project": {
    "name": "Cupidate",
    "description": "픽셀 아트 기반 지인 소개팅 서비스",
    "version": "1.0.0-service-plan",
    "harness_method": {
      "micro_commits": true,
      "state_tracking_files": [
        "docs/agent/feature_list.json",
        "docs/agent/progress.txt"
      ],
      "rules_source": "docs/agent/codexrules.md"
    }
  },
  "domain_rules": {
    "roles": {
      "cupid": "지인을 관리하고 다른 Cupid와 연결되는 주선자",
      "cupidate": "Cupid에게 종속된 소개 대상 엔티티"
    },
    "matching_constraints": [
      "Cupidate 간 직접 검색/직접 매칭 금지",
      "서로 연결된 Cupid 네트워크를 통해서만 매칭률 계산 및 제안"
    ],
    "security": [
      "Supabase RLS 기반 데이터 격리",
      "Cupid는 자신의 Cupidate + 연결된 Cupid의 Cupidate 정보만 조회 가능"
    ]
  },
  "design_and_tech_constraints": {
    "ui_theme": "8-bit/16-bit 레트로 픽셀 아트",
    "styling_rules": [
      "borderRadius 0 또는 계단형 픽셀 모서리만 허용",
      "검은색 굵은 실선 테두리 사용",
      "픽셀 폰트(Galmuri/NeoDunggeunmo 계열) 우선",
      "파스텔/그라데이션 지양, 고채도 원색 팔레트 우선"
    ],
    "stack": {
      "framework": "React Native (Expo Managed Workflow)",
      "state_management": [
        "Zustand",
        "TanStack Query"
      ],
      "backend": "Supabase",
      "animation": "Reanimated 3 with step-based easing"
    }
  },
  "poc_baseline": {
    "status": "completed",
    "completed_at": "2026-03-28",
    "summary": [
      "Supabase 스키마/RLS 기반 데이터 토대 구축",
