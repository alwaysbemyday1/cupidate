{
  "project": {
    "name": "Cupidate",
    "description": "Pixel-art based trusted introduction and matchmaking service",
    "version": "1.2.0-service-foundation",
    "harness_method": {
      "micro_commits": true,
      "state_tracking_files": [
        "docs/agent/feature_list.json",
        "docs/agent/progress.txt",
        "docs/agent/worklog.md"
      ],
      "rules_source": "docs/agent/codexrules.md"
    }
  },
  "domain_rules": {
    "roles": {
      "cupid": "Network orchestrator who manages acquaintances and sends/receives introductions",
      "cupidate": "Person profile managed by a Cupid and evaluated by matching logic"
    },
    "matching_constraints": [
      "Direct cupidate-to-cupidate search is not the primary flow",
      "High-confidence recommendations require accepted network connection between cupids"
    ],
    "security": [
      "Supabase RLS as the baseline for all access paths",
      "Cupid can read own data and connected-network scope only"
    ]
  },
  "critical_focus": {
    "title": "Match-rate correctness and explainability",
    "reason": "Product success depends on trustworthy match quality and transparent recommendation reasons.",
    "source_of_truth": "docs/agent/domain_data.md"
  },
  "service_views": [
    {
      "id": "home",
      "title": "Home View",
      "description": "Notification feed, recommendation summary, and quick actions",
      "core_features": [
        "Activity summary cards",
        "Recent request notifications",
        "Quick navigation to Network and Matching"
      ],
      "spec_path": "docs/agent/views/home.md"
    },
    {
      "id": "network",
      "title": "Network View",
      "description": "Manage own cupidates and connected cupids",
      "core_features": [
        "Cupidate registration and list",
        "Connected cupid request/list/status",
        "Network scope management"
      ],
      "spec_path": "docs/agent/views/network.md"
    },
    {
      "id": "matching",
      "title": "Matching View",
      "description": "Recommendation board and request lifecycle management",
      "core_features": [
        "Recommendation cards with score/reasons",
        "Request/accept/reject flow",
        "Contact-shared completion",
        "Matching history"
      ],
      "spec_path": "docs/agent/views/matching.md"
    },
    {
      "id": "my",
      "title": "My View",
      "description": "Profile/settings/account security controls",
      "core_features": [
        "Nickname/profile settings",
        "Privacy and notification preferences",
        "Account summary"
      ],
      "spec_path": "docs/agent/views/my.md"
    }
  ],
  "service_phases": [
    {
      "id": "S0",
      "title": "Matching Data Foundation",
      "status": "completed",
      "deliverables": [
        "Domain input schema",
        "Validation/normalization",
        "Scoring baseline and reasoning"
      ]
    },
    {
      "id": "S1",
      "title": "Network Data Layer",
      "status": "completed",
      "deliverables": [
        "Network repository interfaces",
        "In-memory + Supabase data source",
        "Network query/mutation hooks"
      ]
    },
    {
      "id": "S2",
      "title": "App Wiring + Matching Persistence",
      "status": "completed",
      "deliverables": [
        "4-view modular app shell",
        "React Query integration in app state",
        "Persisted match request lifecycle"
      ]
    },
    {
      "id": "S3",
      "title": "View Hardening + Pixel UI Rebuild",
      "status": "in_progress",
      "deliverables": [
        "UI interaction tests",
        "Error/loading UX hardening",
        "Supabase auth-flow alignment",
        "Prototype-based pixel UI rebuilding"
      ]
    },
    {
      "id": "S4",
      "title": "Service Readiness",
      "status": "pending",
      "deliverables": [
        "Operational metrics",
        "Rollout checklist",
        "QA and release gates"
      ]
    }
  ],
  "design_system": {
    "reference_docs": [
      "docs/agent/design_system.md"
    ],
    "style_keywords": [
      "pink-navy-pixel-console",
      "hard-pixel-shadow",
      "beige-panel-strong-contrast",
      "korean-pixel-typography"
    ],
    "mandatory_rules": [
      "no-rounded-corners-default",
      "pixelText-wrapper-only",
      "pixelBox-hard-shadow-only",
      "semantic-button-variants",
      "state-visible-ui",
      "designed-empty-loading-error"
    ]
  }
}
